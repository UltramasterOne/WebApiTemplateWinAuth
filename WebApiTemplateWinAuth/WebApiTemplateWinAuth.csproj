<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- -windows: the app uses Windows-only APIs (Active Directory lookup) -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Windows x64 only (no ARM, no Linux) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <SelfContained>false</SelfContained>

    <!-- Optional: only needed if you keep connection strings in user secrets instead of appsettings.
         Replace with a new GUID per project created from this template (dotnet user-secrets init). -->
    <UserSecretsId>webapitemplatewinauth-2e9b6f41-8c3d-4a7e-b5f0-6d1a9c4e7b23</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Scalar.AspNetCore" Version="3.1.1" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.15" />
  </ItemGroup>

</Project>
